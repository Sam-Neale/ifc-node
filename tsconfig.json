{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "bundler",

		"rootDir": "src",
		"outDir": "dist",

		"declaration": true,
		"sourceMap": true,
		"types": ["node"],

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "test"]
}
