{
	"name": "ifc-node",
	"version": "1.0.0",
	"description": "Infinite Flight Connect API Wrapper for Node.JS",
	"keywords": [
		"IF",
		"Infinite",
		"Flight",
		"IF",
		"Connect",
		"v2",
		"IF",
		"Connect",
		"v1",
		"IFC"
	],
	"files": [
		"dist"
	],
	"exports": {
