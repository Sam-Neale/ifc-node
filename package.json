			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"license": "ISC",
	"author": "Sam Neale",
	"type": "commonjs",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"engines": {
