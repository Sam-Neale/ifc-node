		"test:watch": "vitest",
		"prepublishOnly": "npm run lint && npm run test && npm run build"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.5.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	}
